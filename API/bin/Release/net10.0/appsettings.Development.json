{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "LearnToCode",
    "Audience": "LearnToCode",
    "Secret": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_FOR_DEV_ONLY",
    "ExpiryMinutes": 120
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=learn_to_code;Username=postgres;Password=postgres"
  },
  "Redis": {
    "Connection": "localhost:6379"
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "UseSsl": false
  },
  "Theory": {
    "Storage": {
      "BucketName": "learn-to-code",
      "Prefix": "theory",
      "ManifestObject": "index.json",
      "AutoCreateBucket": true,
      "SeedDefaults": true,
      "CacheSeconds": 60
    }
  }
}
