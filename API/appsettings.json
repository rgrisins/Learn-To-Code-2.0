{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "LearnToCode",
    "Audience": "LearnToCode",
    "ExpiryMinutes": 120
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=learn_to_code;Username=postgres;Password=postgres"
  },
  "Redis": {
    "Connection": "redis:6379,password=redis",
    "Database": 0
  },
  "Minio": {
    "Endpoint": "minio:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "UseSsl": false
  },
  "Theory": {
    "Storage": {
      "BucketName": "learn-to-code",
      "Prefix": "theory",
      "AutoCreateBucket": true,
      "CacheSeconds": 60
    }
  },
  "AllowedHosts": "*"
}
