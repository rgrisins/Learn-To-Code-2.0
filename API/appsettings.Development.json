{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "LearnToCode",
    "Audience": "LearnToCode",
    "ExpiryMinutes": 120
  },
  "Theory": {
    "Storage": {
      "BucketName": "learn-to-code",
      "Prefix": "theory",
      "AutoCreateBucket": true,
      "CacheSeconds": 60
    }
  }
}
